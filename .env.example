# Default: direct, keyless connection to the same public read endpoints used by divar.ir web.
DIVAR_PROVIDER=web
DIVAR_CITY_IDS=1
DIVAR_WEB_CATEGORY=light

# 0 means follow Divar cursors until the category ends. The hard cap prevents accidental endless loops.
DIVAR_MAX_PAGES=0
DIVAR_HARD_MAX_PAGES=500
DIVAR_REQUEST_DELAY_MS=450
DIVAR_CACHE_TTL_MINUTES=10
# Shared hosts can become slow if the crawler starts immediately after every restart.
# Keep automatic warmups enabled, but let the first visitors get the SPA before crawling.
STARTUP_WARM=true
STARTUP_WARM_DELAY_MS=60000
MARKET_REFRESH_INTERVAL_MINUTES=10
DIVAR_CACHE_FILE=data/divar-cache.json
# Ceiling for the persisted search cache. Without it the JSON file grows with
# every distinct filter combination and can fill a small hosting quota.
DIVAR_CACHE_MAX_ENTRIES=150
DIVAR_CACHE_MAX_AGE_HOURS=72
# MARKET_STORAGE_MODE=lean keeps ONLY the distilled averages on disk: the crawl
# is summarised in memory and the ads are discarded, search is answered live
# and scored against the stored baseline. 'full' (default) persists every ad.
MARKET_STORAGE_MODE=full
# How often the stored averages are rebuilt from a fresh sweep (lean mode).
BASELINE_REFRESH_DAYS=7
# Max ads one lean sweep holds in memory as slim projections (~150 bytes each).
MARKET_LEAN_SAMPLE=40000
# Storage ceiling for the raw listing working set in 'full' mode. The averages
# that must survive live in market_baseline (~286 bytes per cohort); one raw
# listing costs ~3 KB. 25000 listings ≈ 50 MB and stays flat forever. 0 = no cap.
MARKET_MAX_LISTINGS=25000
# Drop listings not seen for this many days (0 = use the market window).
MARKET_RETENTION_DAYS=0
DATABASE_FILE=data/khodroto.db
# Dedicated administration: /khodroto-admin
ADMIN_PHONE=
# Use a unique 12+ character password; never commit the real value.
ADMIN_PASSWORD=
# 32+ random characters used to encrypt payment/SMS credentials in SQLite. Required in production.
CREDENTIALS_ENCRYPTION_KEY=
# Set by the real payment adapter in production; without it checkout runs in sandbox mode.
PAYMENT_GATEWAY=

# If the application server is outside Iran and Divar rejects its network,
# point this to your own trusted Iran-hosted reverse proxy (origin only).
# Never use a random public proxy.
DIVAR_API_BASE_URL=https://api.divar.ir
# Optional token sent only to your own trusted Iran relay as x-khodroto-relay-token.
DIVAR_RELAY_TOKEN=

# Optional official Kenar integration. Set DIVAR_PROVIDER=kenar and provide a server-side key.
KENAR_API_KEY=
DIVAR_CITY=tehran
DIVAR_CATEGORY=light
