# Default: direct, keyless connection to the same public read endpoints used by divar.ir web.
DIVAR_PROVIDER=web
DIVAR_CITY_IDS=1
DIVAR_WEB_CATEGORY=light

# 0 means follow Divar cursors until the category ends. The hard cap prevents accidental endless loops.
DIVAR_MAX_PAGES=0
DIVAR_HARD_MAX_PAGES=500
DIVAR_REQUEST_DELAY_MS=450
DIVAR_CACHE_TTL_MINUTES=10
DIVAR_CACHE_FILE=data/divar-cache.json
DATABASE_FILE=data/khodroto.db
ADMIN_PHONE=
# Set by the real payment adapter in production; without it checkout runs in sandbox mode.
PAYMENT_GATEWAY=

# If the application server is outside Iran and Divar rejects its network,
# point this to your own trusted Iran-hosted reverse proxy (origin only).
# Never use a random public proxy.
DIVAR_API_BASE_URL=https://api.divar.ir

# Optional official Kenar integration. Set DIVAR_PROVIDER=kenar and provide a server-side key.
KENAR_API_KEY=
DIVAR_CITY=tehran
DIVAR_CATEGORY=light
