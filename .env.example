# Official Kenar-e-Divar integration (recommended)
# Create this key in https://divar.ir/kenar/management/apps with SEARCH_POST and GET_POST permissions.
KENAR_API_KEY=
DIVAR_CITY=tehran
DIVAR_CATEGORY=light
DIVAR_CACHE_TTL_MINUTES=15

# Optional legacy adapter based on Divar's internal web endpoint.
# It is intentionally disabled by default because it is not a stable public API.
DIVAR_ALLOW_UNOFFICIAL=false
